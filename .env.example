GROQ_API_KEY=            # required — agent LLM (openai/gpt-oss-20b via Groq)
TAVILY_API_KEY=          # optional — web search (falls back to DuckDuckGo)
GROQ_MODEL=              # optional — override the Groq model id
LOCAL_LLM_MODEL=         # optional — fine-tuned fallback model (Hub id or local dir), see finetune/
MLFLOW_TRACKING_URI=     # optional — e.g. sqlite:///mlflow.db to log serving metrics (pip install mlflow)
HF_TOKEN=                # only for deployment / pushing models; set it as a GitHub/Kaggle secret, not here
